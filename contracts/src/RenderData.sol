pragma solidity 0.8.28;

/// @title RenderData
/// @notice Precomputed render parameters for all 180 items. Solidity has no
///         floats, so none of this is derived on chain - it is extracted from
///         the JS renderer's actual output by script/GenerateData.mjs and only
///         concatenated here. Do not edit by hand.
library RenderData {
    uint256 internal constant SUPPLY = 180;

    /// @notice The eight orientations: 4 rotations x mirror. White polygon.
    function whitePoly(uint256 i) internal pure returns (string memory) {
        if (i == 0) return "742.3,0 1000,0 1000,1000 349.7,1000";
        if (i == 1) return "1000,742.3 1000,1000 0,1000 0,349.7";
        if (i == 2) return "257.7,1000 0,1000 0,0 650.3,0";
        if (i == 3) return "0,257.7 0,0 1000,0 1000,650.3";
        if (i == 4) return "257.7,0 0,0 0,1000 650.3,1000";
        if (i == 5) return "1000,257.7 1000,0 0,0 0,650.3";
        if (i == 6) return "742.3,1000 1000,1000 1000,0 349.7,0";
        if (i == 7) return "0,742.3 0,1000 1000,1000 1000,349.7";
        revert("bad poly");
    }

    /// @notice ...and the ink polygon for the same orientation.
    function inkPoly(uint256 i) internal pure returns (string memory) {
        if (i == 0) return "0,0 742.3,0 349.7,1000 0,1000";
        if (i == 1) return "1000,0 1000,742.3 0,349.7 0,0";
        if (i == 2) return "1000,1000 257.7,1000 650.3,0 1000,0";
        if (i == 3) return "0,1000 0,257.7 1000,650.3 1000,1000";
        if (i == 4) return "1000,0 257.7,0 650.3,1000 1000,1000";
        if (i == 5) return "1000,1000 1000,257.7 0,650.3 0,1000";
        if (i == 6) return "0,1000 742.3,1000 349.7,0 0,0";
        if (i == 7) return "0,0 0,742.3 1000,349.7 1000,0";
        revert("bad poly");
    }

    /// @notice One packed word per token, low bits first:
    ///         poly:3 | inkRed:1 | glyph:8 | fill:2 | rot:2 | x:17 | y:17 | scale:31
    ///         glyph == 255 means the token carries no word.
    function packed(uint256 tokenId) internal pure returns (uint256 p) {
        require(tokenId >= 1 && tokenId <= 180, "bad id");
        bytes memory t = TABLE;
        assembly {
            // 12 bytes per row, 1-indexed
            p := shr(160, mload(add(add(t, 32), mul(sub(tokenId, 1), 12))))
        }
    }

    bytes internal constant TABLE = hex"";

    /// @notice Traits, two bytes per token, low bits first:
    ///         rot:2 | mirror:1 | word:3 | plane:2 | plate:2 | provenance:1
    ///         word == 6 means Blank; plane == 3 means None.
    function traits(uint256 tokenId) internal pure returns (uint256 a) {
        require(tokenId >= 1 && tokenId <= 180, "bad id");
        bytes memory t = ATTRS;
        assembly {
            a := shr(240, mload(add(add(t, 32), mul(sub(tokenId, 1), 2))))
        }
    }

    bytes internal constant ATTRS = hex"";
}

// The packing, for reference:
//   token 1: poly=0 red=0 glyph=0 fill=0 rot=3 x=96300 y=96300 scale=70000000
//   token 2: poly=0 red=0 glyph=0 fill=0 rot=0 x=74256 y=96300 scale=70000000
//   token 3: poly=0 red=0 glyph=0 fill=0 rot=0 x=74256 y=10700 scale=70000000
